{
  "artists": {
    "name": "artists",
    "title": "통합 아티스트 명부",
    "fields": [
      {
        "name": "slug",
        "type": "TEXT",
        "nullable": false,
        "description": "주소에 사용할 고정 식별 문자열. 이름을 바꿔도 자동 변경하지 않음",
        "example": "hachi"
      },
      {
        "name": "name_native",
        "type": "TEXT",
        "nullable": false,
        "description": "공식 원어 이름",
        "example": "HACHI"
      },
      {
        "name": "name_ko",
        "type": "TEXT",
        "nullable": true,
        "description": "검수한 한국어 이름. 임의 번역 금지",
        "example": "하치"
      },
      {
        "name": "name_latin",
        "type": "TEXT",
        "nullable": true,
        "description": "공식 영어/로마자 표기. 원어와 같으면 생략 가능",
        "example": "NULL"
      },
      {
        "name": "entity_kind",
        "type": "TEXT",
        "nullable": false,
        "description": "solo(개인 활동 주체), group(그룹)",
        "example": "solo",
        "options": [
          "solo",
          "group"
        ]
      },
      {
        "name": "is_virtual",
        "type": "BOOLEAN",
        "nullable": true,
        "description": "가상 캐릭터 활동 여부. NULL은 아직 확인 안 됨",
        "example": "true"
      },
      {
        "name": "agency_id",
        "type": "INTEGER",
        "nullable": true,
        "description": "agencies.id. 소속사가 없거나 미확인일 때 비움",
        "example": "3",
        "reference": "agencies"
      },
      {
        "name": "birthday_month",
        "type": "SMALLINT",
        "nullable": true,
        "description": "생일 월. 생년은 저장하지 않음",
        "example": "8"
      },
      {
        "name": "birthday_day",
        "type": "SMALLINT",
        "nullable": true,
        "description": "생일 일. 월과 함께 입력하거나 함께 비움",
        "example": "1"
      },
      {
        "name": "debut_date",
        "type": "DATE",
        "nullable": true,
        "description": "정확히 확인된 데뷔 날짜. 연도만 알면 날짜를 만들지 않음",
        "example": "2020-08-01"
      },
      {
        "name": "bio",
        "type": "TEXT",
        "nullable": true,
        "description": "검수된 프로필 소개",
        "example": "아티스트 소개문"
      },
      {
        "name": "theme_color",
        "type": "TEXT",
        "nullable": true,
        "description": "캘린더 등에서 쓸 색상. #RRGGBB 형식",
        "example": "#8B74D6"
      },
      {
        "name": "avatar_url",
        "type": "TEXT",
        "nullable": true,
        "description": "프로필 이미지 주소. 없으면 화면의 이름 폴백",
        "example": "https://example.com/avatar.jpg"
      },
      {
        "name": "show_in_catalog",
        "type": "BOOLEAN",
        "nullable": false,
        "description": "사용자 탐색 목록에 노출할지. 수집 여부와 독립",
        "example": "true",
        "default": false
      }
    ],
    "versioned": true,
    "archivable": true
  },
  "artist_aliases": {
